# ═══════════════════ Mercado Pago ═══════════════════
# ⚠️ PENDIENTE: pega aquí tus credenciales de PRUEBA.
# Se obtienen en: https://www.mercadopago.com.mx/developers/panel
#   → Tus integraciones → (tu app) → Credenciales de prueba
MP_ACCESS_TOKEN=TEST-PON-AQUI-TU-ACCESS-TOKEN
MP_PUBLIC_KEY=TEST-PON-AQUI-TU-PUBLIC-KEY

# Secreto de firma de webhooks (opcional; solo si configuras la URL de
# notificaciones en el panel de MP. Déjalo vacío para no validar firma).
MP_WEBHOOK_SECRET=

# URL pública del backend.
# - En local SIN túnel: déjala en localhost. Los webhooks de MP no llegarán;
#   la app usa el botón "Verificar" y las páginas de retorno para confirmar pagos.
# - Con túnel (ngrok / devtunnels) o dominio HTTPS: ponla aquí y se activan
#   automáticamente los webhooks y el auto_return de Checkout Pro.
PUBLIC_URL=http://localhost:3000

# ═══════════════════ Servidor / Auth ═══════════════════
PORT=3000
JWT_SECRET=yakult-reportes-dev-secret

# ═══════════════════ MySQL ═══════════════════
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=yakult_db
